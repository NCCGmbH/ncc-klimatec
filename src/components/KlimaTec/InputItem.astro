---
type FieldType = 'text' | 'email' | 'tel';

type Props = {
  fieldType: FieldType,
  label: string,
  name: string;
  id: string,
  placeholder: string,
  required?: boolean,
}

const { fieldType, label, name, id, placeholder, required=false }: Props = Astro.props;

---

<div class="flex flex-col">
  <label class="font-bold" for={name}>{label}{required && <span class="text-red-600"> *</span>}</label>
  <input placeholder={placeholder} class="border px-2 py-1 rounded-md border-gray-400" type={fieldType} name={name} id={name} required={required} />
</div>