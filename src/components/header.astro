---
import Headline from "./headline.astro"
import Section from "./Section.astro"
import Button from "./Button.astro"
---
<div id="home" class="block h-[5rem] -mt-[5rem]"></div>
<section class="relative w-full overflow-hidden">
  <img src="/public/images/farn.jpg" alt="header image" class="w-full object-cover h-[calc(100vh-5rem)] max-md:min-h-[100vw] md:max-h-[700px]" />
  
  <div class="absolute inset-0 w-full max-w-[1200px] md:px-[5%] mx-auto self-center">
    <div class="space-y-8 md:space-y-4 w-full md:max-w-[600px]">
      <div class="max-md:px-[5%]">
        <Headline level={1} textColor="white">Ihre Gesundheit ganzheitlich verstehen und stärken</Headline>
      </div>
      <div class="bg-white/80 max-md:px-[5%] max-md:py-6 md:p-6 md:rounded-2xl shadow-xl flex flex-col gap-4">
        <Headline level={2}>Mit moderner Orthomolekularmedizin, Mikronährstofftherapie und integrativer Beratung fundiert, individuell, effektiv.</Headline>
        <Button onClickEvent="https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form">Termin vereinbaren</Button>
      </div>
    </div>
  </div>
</section>
