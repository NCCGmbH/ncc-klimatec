---
import { Image } from 'astro:assets';
import HeroImage from '../assets/images/farn.jpg';

import Headline from "./headline.astro"
import Button from "./Button.astro"
---
<div id="home" class="block h-[5rem] -mt-[5rem]"></div>
<section class="relative w-full overflow-hidden">
  <Image
    src={HeroImage}
    alt="Hero"
    widths={[400, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 800px"
    format="webp"
    class="w-full object-cover h-[calc(100vh-5rem)] max-md:min-h-[100vw] md:max-h-[700px]"
    priority
    loading="eager"
  />
  <div class="absolute inset-0 w-full max-w-[1200px] md:px-[5%] mx-auto self-center">
    <div class="space-y-8 md:space-y-4 w-full md:max-w-[600px]">
      <div class="max-md:px-[5%]">
        <h1 class="text-4xl sm:text-5xl text-white text-shadow">Ihre Gesundheit ganzheitlich verstehen und stärken</h1>
      </div>
      <div class="bg-white/80 max-md:px-[5%] max-md:py-6 md:p-6 md:rounded-2xl shadow-xl flex flex-col gap-4">
        <Headline level={2}>Mit moderner Orthomolekularmedizin, Mikronährstofftherapie und integrativer Beratung fundiert, individuell, effektiv.</Headline>
        <Button as="a" href="https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form">Termin vereinbaren</Button>
      </div>
    </div>
  </div>
</section>
