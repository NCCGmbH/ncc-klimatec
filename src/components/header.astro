---
import { Image } from 'astro:assets';
import HeroImage from '../assets/images/farn.jpg';

import Headline from "./headline.astro"
import Button from "./Button.astro"
---
<div id="home" class="block h-[5rem] -mt-[5rem]"></div>
<section class="relative w-full overflow-hidden">
  <Image
    src={HeroImage}
    alt="Hero"
    widths={[400, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 800px"
    format="webp"
    class="w-full object-cover h-[calc(100vh-5rem)] max-md:min-h-[100vw] md:max-h-[700px]"
    priority
    loading="eager"
  />
  <div class="absolute z-20 inset-0 bg-[#003a24]/70 md:bg-teal-800/40 mix-blend-multiply"></div>
  <div class="absolute z-30 inset-0 w-full max-w-[1200px] max-md:pb-20 md:px-[5%] mx-auto flex flex-col justify-center">
    <div class="space-y-8 md:space-y-4 w-full md:max-w-[600px] max-md:px-[5%]">
      <div class="">
        <Headline shadow textColor="white" level={1}>Ihre Gesundheit ganzheitlich verstehen und stärken</Headline>
      </div>
      <div class="flex flex-col gap-4">
        <Headline shadow textColor="white" level={3}>Mit moderner Orthomolekularmedizin, Mikronährstofftherapie und individuelle Beratung<br />&ndash; fundiert, individuell, effektiv</Headline>
        <Button dark as="a" href="https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form">Jetzt Termin vereinbaren</Button>
      </div>
    </div>
  </div>
</section>
