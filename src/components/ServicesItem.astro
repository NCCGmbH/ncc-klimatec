---
import Headline from './headline.astro';

type Props = {
  image: string,
  headline: string,
}

const {
  image,
  headline
}: Props = Astro.props;
---

<div class="flex flex-col gap-8">
  <img src=`/images/${image}` alt="Header" class="w-full aspect-square object-cover rounded-3xl sm:rounded-3xl lg:rounded-2xl shadow-lg" />
  <div class="flex flex-col gap-2">
    <Headline level={3}>{headline}</Headline>
    <div>
      <slot />
    </div>
  </div>
</div>