---
import type { boolean } from 'astro:schema';
import Headline from './Headline.astro';
import { Image } from 'astro:assets';

type Props = {
  image: ImageMetadata,
  alt: string,
  headline: string,
  id: number,
  fullWidth?: boolean,
  padding?: boolean,
}

const {
  image,
  alt,
  headline,
  id,
  fullWidth = false,
  padding = false,
}: Props = Astro.props;
---

<style>
  .overlay-toggle:checked ~ .service-overlay {
    display: flex;
  }
  .service-overlay {
    display: none;
  }
</style>

<div class="flex flex-col gap-8">
  <input type="checkbox" id={"overlay-toggle-" + id} class="overlay-toggle hidden" />
  <label for={"overlay-toggle-" + id} class="cursor-pointer bg-white rounded-xl shadow-lg aspect-square overflow-hidden flex items-center justify-center">
    <Image
      src={image}
      alt={alt}
      widths={[300, 600]}
      sizes="(max-width: 768px) 100vw, 600px"
      class:list={["w-full", fullWidth ? "" : "aspect-square object-cover", padding && "px-4"]}
    />
  </label>
  <div class="flex flex-col gap-2">
    <Headline level={3}>{headline}</Headline>
    <div>
      <slot />
    </div>
  </div>
  <label for={"overlay-toggle-" + id} class="service-overlay fixed inset-0 z-50 bg-black/40 backdrop-blur-lg items-center justify-center">
    <Image
      src={image}
      alt={alt}
      widths={[400, 800, 1200]}
      class="object-cover rounded-xl max-w-[95vw] sm:max-w-[min(80vw,1080px)] max-h-[80vh]"
    />
  </label>
</div>
