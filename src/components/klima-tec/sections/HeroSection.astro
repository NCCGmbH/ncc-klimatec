---
import { Image } from 'astro:assets';

import Headline from "../atoms/Headline.astro"
import Button from "../atoms/Button.astro"
import Underscore from '../atoms/Underscore.astro';
import Section from '../../Section.astro';
import HeroItems from '../molecules/HeroItems.astro';

type Props = {
  id: string,
  image: ImageMetadata,
};

const { id, image }: Props = Astro.props;
---

<Section {id} fullWidth paddingBottom='none' paddingTop='none'>
  <div class="relative grid">
    <Image
      src={image}
      alt="Hero"
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 800px"
      format="webp"
      class:list={[
        "col-start-1 row-start-1 w-full object-cover object-right",
        "min-h-[620px] lg:min-h-[680px] lg:px-[1px] max-lg:opacity-50"
      ]}
      priority
      loading="eager"
    />
    <div class:list={[
      "col-start-1 max-md:h-[calc(100vh-56px)] row-start-1 flex justify-center z-10 px-4 lg:px-8 py-8 md:py-16 max-w-full lg:max-w-[35rem]",
      "bg-gradient-to-t from-ncc-light-blue from-0% via-ncc-light-blue via-40% to-transparent to-100%",
      "lg:bg-gradient-to-r lg:from-0% lg:via-90%"
    ]}>
      <div class="flex flex-col gap-4 max-w-[35rem]">
        <slot />
      </div>
    </div>
    <svg
      class="absolute bottom-[-1px] left-0 w-full h-24 md:h-32 lg:z-20"
      viewBox="0 0 1440 40"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,20 C300,40 1080,20 1440,0 L1440,40 L0,40 Z"
        class="fill-white"
      />
    </svg>
  </div>
</Section>