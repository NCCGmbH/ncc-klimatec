---
import { Image } from 'astro:assets';

import Headline from "../atoms/Headline.astro"
import Button from "../atoms/Button.astro"
import Underscore from '../atoms/Underscore.astro';
import Section from '../../Section.astro';
import HeroItems from '../molecules/HeroItems.astro';
import SectionHeadline from '../atoms/SectionHeadline.astro';
import ContactForm from '../molecules/ContactForm.astro';

type Props = {
  id: string,
  image: ImageMetadata,
};

const { id, image }: Props = Astro.props;
---

<Section {id} fullWidth class="max-lg:px-4">
  <div class="grid rounded-lg shadow-[0_0_15px] shadow-black/25 overflow-hidden">
    <Image
      src={image}
      alt="Hero"
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 800px"
      format="webp"
      class:list={["col-start-1 row-start-1 w-full h-full max-lg:max-h-[700px] object-cover object-right"]}
      priority
      loading="eager"
    />
    <div class="col-start-1 row-start-1 grid grid-cols-1 lg:grid-cols-6">
      <div class:list={[
        "flex flex-col gap-4 px-8 py-8 max-w-[35rem] lg:col-start-1 lg:col-span-2",
        "max-sm:bg-white/75 sm:bg-gradient-to-r sm:from-white from-0% sm:via-white via-80% to-transparent to-100%"  
      ]}>
        <SectionHeadline>Kontakt</SectionHeadline>
        <Headline bold>
          Ihre Klimaanlage - individuell geplant
        </Headline>
        <p>Unverbindlich anfragen - wir beraten Sie gerne!</p>
      </div>
      <div class="lg:col-start-3 lg:col-span-4 lg:pr-8 lg:py-8">
        <ContactForm class="max-lg:!shadow-none max-lg:!rounded-none" />
      </div>
    </div>
  </div>
</Section>
