---

type ButtonType = "button" | "link";

type Props = {
  as?: ButtonType,
  href?: string,
  class?: string,
  type?: "button" | "submit" | "reset",
} & astroHTML.JSX.HTMLAttributes

const {
  as="link",
  href,
  type,
  class: classList,
  ...attrs
}: Props = Astro.props;

const Tag = (
  {
    "button": "button",
    "link": "a",
  } as const
)[as];
---

<Tag class:list={[
  "group-data-[page-design='ncc']/design:bg-sky-900 group-data-[page-design='klimatec']/design:bg-blue-900 text-white rounded-md px-4 py-[6px] text-[14px] flex items-center gap-2 text-nowrap h-fit w-fit cursor-pointer group-data-[page-design='ncc']/design:hover:bg-sky-950 group-data-[page-design='klimatec']/design:hover:bg-blue-950 transition-colors",
  classList
]} {href} {type} {...attrs}>
  <slot />
  <slot name="icon" />
</Tag>
