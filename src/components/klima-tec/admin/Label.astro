---
type Props = {
  status: "Offen" | "InKontakt" | "AuftragAngenommen" | "Abgeschlossen" | "Gelöscht",
}

const { status="Offen" }: Props = Astro.props;

const colorClass = {
  "Offen": "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20",
  "InKontakt": "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20",
  "AuftragAngenommen": "bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20",
  "Abgeschlossen": "bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20",
  "Gelöscht": "bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-500/20",
}[status];

const text = {
  "Offen": "Neu",
  "InKontakt": "In Kontakt",
  "AuftragAngenommen": "Auftrag angenommen",
  "Abgeschlossen": "Abgeschlossen",
  "Gelöscht": "Gelöscht",
}[status];

const IconSize = "16";
const IconWeight = 2;
---

<div class:list={["px-2 py-2 md:py-1 md:px-3 text-xs font-semibold rounded-full w-fit text-nowrap flex gap-2 items-center", colorClass]}>
  {
    status === "AuftragAngenommen" ? (
      <svg xmlns="http://www.w3.org/2000/svg" width={IconSize} height={IconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={IconWeight} stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-handshake-icon lucide-handshake"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
    ) : status === "Offen" ? (
      <svg xmlns="http://www.w3.org/2000/svg" width={IconSize} height={IconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={IconWeight} stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
    ) : status === "InKontakt" ? (
      <svg xmlns="http://www.w3.org/2000/svg" width={IconSize} height={IconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={IconWeight} stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-icon lucide-message-circle"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
    ) : status === "Abgeschlossen" ? (
      <svg xmlns="http://www.w3.org/2000/svg" width={IconSize} height={IconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={IconWeight} stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-party-popper-icon lucide-party-popper"><path d="M5.8 11.3 2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"/></svg>
    ) : status === "Gelöscht" && (
      <svg xmlns="http://www.w3.org/2000/svg" width={IconSize} height={IconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={IconWeight} stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
    )
  }
  <p class="max-md:hidden">{text}</p>
</div>
