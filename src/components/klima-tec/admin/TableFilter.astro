---
import Button from "../atoms/Button.astro";

type Props = {
  selectedStates?: string[],
}

const { selectedStates = [] }: Props = Astro.props;

const STATUS_OPTIONS = [
  { value: "Offen", label: "Neu" },
  { value: "InKontakt", label: "In Kontakt" },
  { value: "AuftragAngenommen", label: "Auftrag angenommen" },
  { value: "Abgeschlossen", label: "Abgeschlossen" },
  { value: "Gelöscht", label: "Gelöscht" },
];

const summaryText =
  selectedStates.length === 0 ? "Status" :
  selectedStates.length <= 2 ? selectedStates.map((value) => STATUS_OPTIONS.find((o) => o.value === value)?.label ?? value).join(", ") :
  `${STATUS_OPTIONS.find((o) => o.value === selectedStates[0])?.label ?? selectedStates[0]} +${selectedStates.length - 1}`;

const searchFilter = Astro.url.searchParams.get("search");
const fromFilter = Astro.url.searchParams.get("from");
const toFilter = Astro.url.searchParams.get("to");

const filterActive = (searchFilter || selectedStates.length > 0 || fromFilter || toFilter);
---

<form data-table-filter class="flex flex-col gap-4 rounded-xl bg-white shadow-[0_0_15px] shadow-black/25 p-4 lg:flex-row lg:items-end lg:justify-between">
  <div class="flex flex-wrap gap-4">
    <div class="flex flex-col gap-1.5">
      <label class="text-xs font-semibold uppercase tracking-wide text-gray-500" for="search">
        Suche
      </label>
      <div class="relative">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <input value={searchFilter} class="w-full rounded-md border border-gray-300 bg-white py-1.5 pl-8 pr-2 text-sm outline-blue-900 sm:w-56" type="text" name="search" id="search" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Datum
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <input value={fromFilter} aria-label="Von" class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm outline-blue-900" name="from" id="from" type="date" />
        <span class="text-gray-400">–</span>
        <input value={toFilter} aria-label="Bis" class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm outline-blue-900" name="to" id="to" type="date" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Status</p>
      <details data-status-filter class="relative">
        <summary class="flex items-center gap-1.5 cursor-pointer list-none rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm select-none">
          <span data-status-filter-summary>{summaryText}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="absolute z-10 mt-1 flex w-max max-w-[calc(100vw-2rem)] flex-col gap-1 rounded-md border border-gray-200 bg-white p-2 shadow-lg">
          {STATUS_OPTIONS.map((option) => (
            <label class="flex items-center gap-2 rounded px-1 py-0.5 text-sm hover:bg-gray-100">
              <input
                type="checkbox"
                name="state"
                value={option.value}
                checked={selectedStates.includes(option.value)}
              />
              {option.label}
            </label>
          ))}
        </div>
      </details>
    </div>
  </div>

  <div class="flex items-center gap-4">
    {
      filterActive && (
        <button type="button" data-reset-filter class="cursor-pointer text-sm font-medium text-gray-500 underline-offset-2 transition-colors hover:text-blue-900 hover:underline">
          Zurücksetzen
        </button>
      )
    }
    <Button as="button" type="submit">
      Filtern
    </Button>
  </div>
</form>

<script>
  const STATUS_LABELS: Record<string, string> = {
    Offen: "Neu",
    InKontakt: "In Kontakt",
    AuftragAngenommen: "Auftrag angenommen",
    Abgeschlossen: "Abgeschlossen",
    Gelöscht: "Gelöscht",
  };

  document.querySelectorAll<HTMLDetailsElement>("[data-status-filter]").forEach((details) => {
    const summary = details.querySelector<HTMLElement>("[data-status-filter-summary]");
    const checkboxes = details.querySelectorAll<HTMLInputElement>('input[name="state"]');

    const updateSummary = () => {
      if (!summary) return;
      const checked = [...checkboxes].filter((checkbox) => checkbox.checked).map((checkbox) => STATUS_LABELS[checkbox.value] ?? checkbox.value);

      summary.textContent =
        checked.length === 0 ? "Status" :
        checked.length <= 2 ? checked.join(", ") :
        `${checked[0]} +${checked.length - 1}`;
    };

    checkboxes.forEach((checkbox) => checkbox.addEventListener("change", updateSummary));
  });

  document.addEventListener("click", (event) => {
    document.querySelectorAll<HTMLDetailsElement>("[data-status-filter][open]").forEach((details) => {
      if (!details.contains(event.target as Node)) details.removeAttribute("open");
    });
  });
</script>
