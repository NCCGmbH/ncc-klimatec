---

import IconCircle from '../atoms/IconCircle.astro';
import Headline from '../atoms/Headline.astro';

type Props = {
  title: string,
}

const { title }: Props = Astro.props;
---

<div class="flex gap-4">
  <IconCircle size="sm">
    <slot name="icon" />
  </IconCircle>
  <div class="flex flex-col gap-2">
    <Headline color="white" bold level={4}>{title}</Headline>
    <div class="text-sm">
      <slot />
    </div>
  </div>
</div>
