---
import { Image } from 'astro:assets';
import logo from '../../../assets/svgs/ncc-klimatec-logo.svg?raw';

type Props = {
  links: { text: string, href: string }[];
};

const { links }: Props = Astro.props;
---

<div id="nav-overlay" class="fixed inset-0 z-40 hidden"></div>

<nav id="navbar" class="sticky overflow-x-clip overflow-y-visible md:overflow-visible top-0 h-12 z-50 w-full backdrop-blur-xl bg-white/75 max-w-full shadow-black/25 transition-all">
  <div class="mx-auto max-w-[1200px] h-full grid grid-cols-[auto_1fr] md:items-center text-blue-900 transition-all text-xl md:text-[1.2rem]">
    <div id="logo" class="row-start-1 cursor-pointer [&>*]:max-w-20 [&>*]:h-auto w-fit col-start-1 col-span-1 bg-transparent ml-[5vw] md:ml-[4vw] xl:ml-0 my-auto justify-self-start p-1">
      <Fragment set:html={logo} />
    </div>
    {
      links.length > 0 && (
        <div id="hamburger" class="p-2 rounded-lg row-start-1 col-start-2 mr-[5vw] md:mr-10 col-span-1 my-auto justify-self-end flex flex-col gap-[6px] cursor-pointer md:hidden [&>span]:transition-all [&>span]:duration-300">
          <span id="ham-1" class="bg-blue-900 h-1 w-10 rounded-full" />
          <span id="ham-2" class="bg-blue-900 h-1 w-10 rounded-full" />
          <span id="ham-3" class="bg-blue-900 h-1 w-10 rounded-full" />
        </div>
        <ol id="nav-links" class:list={[
          "hidden absolute flex-col md:flex md:static md:flex-row overflow-hidden",
          "bg-white max-md:mt-16 md:bg-transparent shadow-xl md:shadow-none",
          "translate-x-full right-0 md:translate-x-0", 
          "rounded-bl-xl md:rounded-md",
          "opacity-0 md:opacity-100", 
          "row-start-2 md:row-start-1 col-start-1 md:col-start-2 col-span-2 md:col-span-1", 
          "md:my-auto md:mr-[4vw] xl:mr-0 md:gap-3 lg:gap-8 md:px-5 xl:px-0 md:py-2", 
          "w-fit justify-self-end",
          "transition-all"
        ]}>
          { links.map((link) => (
            <li>
              <a class="nav-link block md:inline-block hover:bg-blue-900 md:hover:bg-transparent hover:text-white md:hover:text-blue-950 text-center py-4 text-2xl md:text-base md:py-0 px-5 md:px-0 transition-all" href={link.href}>
                {link.text}
              </a>
            </li>
          )) }
        </ol>
      )
    }
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const navLinks = document.getElementById('nav-links');
  const allLinks = document.getElementsByClassName('nav-link');
  const hamburger = document.getElementById('hamburger');
  const ham1 = document.getElementById('ham-1');
  const ham2 = document.getElementById('ham-2'); 
  const ham3 = document.getElementById('ham-3');
  const navOverlay = document.getElementById('nav-overlay');
  const logo = document.getElementById('logo');

  logo?.addEventListener('click', () => {
    if (window.location.pathname === '/') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (window.innerWidth < 768) {
        closeNav();
      }
    } else {
      window.location.href = '/klimatec/';
    }
  });

  function openNav() {
    /** Burger -> X */
    hamburger?.classList.add('pointer-events-none');
    ham1?.classList.add('rotate-45', 'translate-y-[10px]');
    ham2?.classList.add('!bg-transparent');
    ham3?.classList.add('-rotate-45', '-translate-y-[10px]');

    /** Nav Overlay */
    navOverlay?.classList.remove('hidden');

    /** Nav Links */
    navLinks?.classList.remove('hidden');
    navLinks?.classList.add('flex');
    setTimeout(() => {
      navbar?.classList.remove('overflow-x-clip');
      navLinks?.classList.remove('translate-x-full');
      navLinks?.classList.remove('opacity-0');
      hamburger?.classList.remove('pointer-events-none');
    }, 1);
  }

  function closeNav() {
    /** X -> Burger */
    ham1?.classList.remove('rotate-45', 'translate-y-[10px]');
    ham2?.classList.remove('!bg-transparent');
    ham3?.classList.remove('-rotate-45', '-translate-y-[10px]');
    hamburger?.classList.add('pointer-events-none');

    /** Nav Overlay */
    navOverlay?.classList.add('hidden');

    /** Nav Links */
    navLinks?.classList.add('pointer-events-none');
    navLinks?.classList.add('translate-x-full');
    navLinks?.classList.add('opacity-0');
    setTimeout(() => {
      navLinks?.classList.remove('flex');
      navLinks?.classList.add('hidden');
      navLinks?.classList.remove('pointer-events-none');
      hamburger?.classList.remove('pointer-events-none');
      navbar?.classList.add('overflow-x-clip');
    }, 150);
  }

  hamburger?.addEventListener('click', () => {
    const isClosed = navLinks?.classList.contains('hidden');

    if (isClosed) {
      openNav();
    } else {
      closeNav();
    }
  });

  navOverlay?.addEventListener('click', () => {
    closeNav();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      closeNav();
    }
  });

  Array.from(allLinks).forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) {
        closeNav();
      }
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      navbar?.classList.add('!backdrop-blur-xl', 'shadow-[0_0_10px]', '!bg-white/75');
    } else {
      navbar?.classList.remove('!backdrop-blur-xl', 'shadow-[0_0_10px]', '!bg-white/75');
    }
  });
</script>
