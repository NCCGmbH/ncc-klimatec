---
import IconCircle from "../atoms/IconCircle.astro";
import Headline from "../atoms/Headline.astro";


type Props = {
  title: string,
  color?: "blue" | "green",
  class?: string,
}

const { title, color="blue", class: classList }: Props = Astro.props;
---

<div class:list={["flex flex-col items-center gap-1 md:gap-2", classList]}>
  <IconCircle bgColor="transparent" {color} class="bg-transparent!">
    <slot name="icon" />
  </IconCircle>
  <Headline bold level={4}>{title}</Headline>
  <div class="text-center">
    <slot />
  </div>
</div>
