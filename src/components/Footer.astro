---
type Props = {
  text: string,
  links: {
    text: string,
    href: string
  }[],
};

const { text, links }: Props = Astro.props;
---

<footer class="w-full px-[3%] pt-24 pb-12 bg-blue-950 text-white text-base">
  <slot />
  <div class="gap-4 flex max-md:flex-col items-center justify-center">
    <p class="text-center">{text}</p>
    <span class="max-md:hidden">|</span>
    <div class="flex gap-4 flex-wrap justify-center">
      {links.map((link, idx) => (
        <>
          <a class="hover:underline" href={link.href}>{link.text}</a>
          {idx < links.length - 1 && <span> | </span>}
        </>
      ))}
    </div>
  </div>
</footer>
