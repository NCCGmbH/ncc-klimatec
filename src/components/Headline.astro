---
import type { HeadlineColor, HeadlineLevel } from "../types";

type Props = {
  level?: HeadlineLevel,
  textColor?: HeadlineColor,
  underline?: boolean,
  shadow?: boolean,
  bold?: boolean,
  small?: boolean,
}

const { level=2, textColor="green", underline=false, shadow=false, bold=false, small=false }: Props = Astro.props

const textColorClass = {
  white: "text-white",
  green: "text-sky-800",
  black: "text-black",
}[textColor];
---
<div class:list={[textColorClass, "break-words leading-tight"]}>
  { (level == 1) && <h1 class:list={[small ? "text-4xl" : "text-5xl", shadow && "text-shadow"]}><slot/></h1> }
  { (level == 2) && <h2 class:list={[small ? "text-xl" : "text-3xl", shadow && "text-shadow"]}><slot/></h2> }
  { (level == 3) && <h3 class:list={[small ? "text-lg" : "text-xl", shadow && "text-shadow-small", bold && "font-semibold"]}><slot/></h3> }
  { underline && <div class="h-1 w-24 bg-gradient-to-r from-blue-900 to-red-300 rounded-full"></div>}
</div>

<style>
  .text-shadow {
    text-shadow: 2px 2px 4px #000000; /* Beispiel: blauer Schatten */
  }
</style>

<style>
  .text-shadow-small {
    text-shadow: 1px 1px 2px #000000; /* Beispiel: blauer Schatten */
  }
</style>
