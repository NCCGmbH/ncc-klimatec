---
import Section from "./Section.astro"
import Headline from "./Headline.astro"
import Form from "./Form.astro"
import InputField from "./InputField.astro"
import Button from "./Button.astro";

type Props = {
  bgColor?: "white" | "gray",
  contactLines: string[],
  button?: {
    text: string,
    href: string
  },
};

const { contactLines, button, bgColor }: Props = Astro.props;
---

<Section
  {bgColor}
  id="contact"
>
  <div class="grid md:grid-cols-2 gap-12 md:gap-8">
    <div class="flex flex-col gap-8">
      <Headline level={2} underline>Kontakt</Headline>
      <div class="flex flex-col gap-6">
        <ol class="list-none space-y-2">
          {contactLines.map((line) => (
            <li>{line}</li>
          ))}
        </ol>
        {button && (
          <Button as="a" href={button.href}>{button.text}</Button>
        )}
      </div>
    </div>
    <div class="flex flex-col gap-4">
      <slot />
    </div>
  </div>
</Section>