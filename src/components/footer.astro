---
type Props = {
  links?: { text: string, href: string }[]
};

const {links}: Props = Astro.props;
---

<footer class="w-full gap-4 py-12 bg-teal-900">
  <slot />
  {links && (
    <ol class="flex gap-4 justify-center">
      {links.map(link => (
        <li class="text-white hover:underline"><a href={link.href}>{link.text}</a></li>
      ))}
    </ol>
  )}
</footer>