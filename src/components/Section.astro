---
import type { BgColors, Padding } from "../types";

type Props = {
  bgColor?: BgColors,
  paddingTop?: Padding,
  paddingBottom?: Padding,
  fullWidth?: boolean,
  id?: string,
  class?: string,
}

const { bgColor = "white", paddingTop = "large", paddingBottom = "large", fullWidth=false, id, class: classList }: Props = Astro.props;

const bgColorClass = {
  white: "bg-white",
  gray: "bg-gray-100",
  green: "bg-green-700",
  blue: "bg-ncc-light-blue",
  navi: "bg-blue-950",
  "sky-dark": "bg-sky-950",
}[bgColor] || "bg-white";

const paddingTopClass = {
  none: "pt-0",
  small: "pt-6",
  medium: "pt-12",
  large: "pt-20 lg:pt-32",
}[paddingTop] || "pt-20";

const paddingBottomClass = {
  none: "pb-0",
  small: "pb-6",
  medium: "pb-12",
  large: "pb-20 lg:pb-32",
}[paddingBottom] || "pt-20";
---

<section id={id} class:list={[bgColorClass, paddingTopClass, paddingBottomClass, "scroll-mt-12", classList]}>
  <div class:list={["mx-auto max-w-[1200px] w-full", !fullWidth && "max-xl:px-4"]}>
    <slot />
  </div>
</section>