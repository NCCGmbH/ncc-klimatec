---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.jpeg';

type Props = {
  links: { text: string, href: string }[];
};

const { links }: Props = Astro.props;
---

<div id="nav-overlay" class="fixed inset-0 z-40 hidden"></div>

<nav id="navbar" class="sticky overflow-y-visible overflow-x-clip md:overflow-visible top-0 z-50 h-20 w-full max-w-full grid grid-cols-[auto_1fr] md:items-center bg-white backdrop-blur-lg text-teal-800 transition-all text-xl md:text-[1.2rem] shadow-xl shadow-teal-400/10">
  <Image
    src={logo}
    loading="eager"
    alt="Logo"
    widths={[128, 256, 512]}
    sizes="128px"
    priority
    format="webp"
    class="row-start-1 w-auto h-12 object-scale-down col-start-1 col-span-1 bg-[#f8f8f8] ml-[5vw] md:ml-10 my-auto justify-self-start cursor-default p-2 rounded-lg"
  />
  <div id="hamburger" class="p-2 bg-white rounded-lg row-start-1 col-start-2 mr-[5vw] md:mr-10 col-span-1 my-auto justify-self-end flex flex-col gap-[6px] cursor-pointer md:hidden [&>span]:transition-all [&>span]:duration-300">
    <span id="ham-1" class="bg-teal-800 h-[6px] w-10 rounded-full" />
    <span id="ham-2" class="bg-teal-800 h-[6px] w-10 rounded-full" />
    <span id="ham-3" class="bg-teal-800 h-[6px] w-10 rounded-full" />
  </div>
  <ol id="nav-links" class:list={[
    "hidden absolute flex-col md:flex md:static md:flex-row overflow-hidden",
    "bg-white shadow-xl md:shadow-none",
    "translate-x-full md:translate-x-0", 
    "rounded-bl-2xl md:rounded-full",
     "border-t-2 border-teal-700 md:border-none", 
     "opacity-0 md:opacity-100", 
     "row-start-2 md:row-start-1 col-start-1 md:col-start-2 col-span-2 md:col-span-1", 
     "md:my-auto md:mr-10 md:gap-4 lg:gap-8 md:px-5 md:py-2", 
     "w-fit justify-self-end",
     "transition-all"
  ]}>
    { links.map((link) => (
      <li>
        <a class="nav-link block md:inline-block hover:bg-teal-800 md:hover:bg-transparent hover:text-white md:hover:text-gray-800 text-center py-3 md:py-0 px-5 md:px-0 transition-all" href={link.href}>
          {link.text}
        </a>
      </li>
    )) }
  </ol>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const navLinks = document.getElementById('nav-links');
  const allLinks = document.getElementsByClassName('nav-link');
  const hamburger = document.getElementById('hamburger');
  const ham1 = document.getElementById('ham-1');
  const ham2 = document.getElementById('ham-2'); 
  const ham3 = document.getElementById('ham-3');
  const navOverlay = document.getElementById('nav-overlay');

  function openNav() {
    /** Burger -> X */
    hamburger?.classList.add('pointer-events-none');
    ham1?.classList.add('rotate-45', 'translate-y-[12px]');
    ham2?.classList.add('bg-transparent');
    ham3?.classList.add('-rotate-45', '-translate-y-[12px]');

    /** Nav Overlay */
    navOverlay?.classList.remove('hidden');

    /** Nav Links */
    navLinks?.classList.remove('hidden');
    navLinks?.classList.add('flex');
    setTimeout(() => {
      navbar?.classList.remove('overflow-x-clip');
      navLinks?.classList.remove('translate-x-full');
      navLinks?.classList.remove('opacity-0');
      hamburger?.classList.remove('pointer-events-none');
    }, 1);
  }

  function closeNav() {
    /** X -> Burger */
    ham1?.classList.remove('rotate-45', 'translate-y-[12px]');
    ham2?.classList.remove('bg-transparent');
    ham3?.classList.remove('-rotate-45', '-translate-y-[12px]');
    hamburger?.classList.add('pointer-events-none');

    /** Nav Overlay */
    navOverlay?.classList.add('hidden');

    /** Nav Links */
    navLinks?.classList.add('pointer-events-none');
    navLinks?.classList.add('translate-x-full');
    navLinks?.classList.add('opacity-0');
    setTimeout(() => {
      navLinks?.classList.remove('flex');
      navLinks?.classList.add('hidden');
      navLinks?.classList.remove('pointer-events-none');
      hamburger?.classList.remove('pointer-events-none');
      navbar?.classList.add('overflow-x-clip');
    }, 150);
  }

  hamburger?.addEventListener('click', () => {
    const isClosed = navLinks?.classList.contains('hidden');

    if (isClosed) {
      openNav();
    } else {
      closeNav();
    }
  });

  navOverlay?.addEventListener('click', () => {
    closeNav();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      closeNav();
    }
  });

  Array.from(allLinks).forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) {
        closeNav();
      }
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      navbar?.classList.add('!backdrop-blur-lg', 'shadow-sm', '!bg-transparent', 'border-teal-700', 'border-b-2');
      navLinks?.classList.add('md:!bg-teal-900', 'md:text-white');
      Array.from(allLinks).forEach(link => {
        link.classList.add('hover:!text-gray-300');
      });
    } else {
      navbar?.classList.remove('!backdrop-blur-lg', 'shadow-sm', '!bg-transparent', 'border-teal-700', 'border-b-2');
      navLinks?.classList.remove('md:!bg-teal-900', 'md:text-white');
      Array.from(allLinks).forEach(link => {
        link.classList.remove('hover:!text-gray-300');
      });
    }
  });
</script>

