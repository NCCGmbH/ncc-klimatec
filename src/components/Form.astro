---
type Props = {
  fid?: string;
  fmethod?: string;
}

const { fid, fmethod }: Props = Astro.props;
---

<form 
  id={fid ?? undefined} 
  method={fmethod ?? undefined} 
  class="w-full flex flex-col max-h-fit gap-4 bg-gray-100 shadow-lg p-4 border-2 border-teal-700 rounded-2xl"
>
  <slot />
</form>
