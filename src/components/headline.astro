---
import type { HeadlineColor, HeadlineLevel } from "../types";

type Props = {
  level?: HeadlineLevel,
  textColor?: HeadlineColor,
  underline?: boolean,
}

const { level=2, textColor="green", underline=false }: Props = Astro.props

const textColorClass = {
  white: "text-white",
  green: "text-teal-800",
  black: "text-black",
}[textColor];
---
<div class:list={[textColorClass, "break-words"]}>
  { (level == 1) && <h1 class="text-4xl sm:text-5xl text-shadow"><slot/></h1> }
  { (level == 2) && <h2 class="text-3xl"><slot/></h2> }
  { (level == 3) && <h3 class="text-xl font-bold"><slot/></h3> }
  { underline && <div class="h-1 w-24 bg-gradient-to-r from-green-500 to-cyan-500 rounded-full"></div>}
</div>

<style>
  .text-shadow {
    text-shadow: 2px 2px 4px #000000; /* Beispiel: blauer Schatten */
  }
</style>
