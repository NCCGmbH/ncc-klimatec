---
import BaseLayout from "./baseLayout.astro";
import Footer from "../components/footer.astro";
import MainNav from "../components/mainNav.astro";

type Props = {
  title: string,
  description: string,
  image: string,
  domain: string,
  ownFooter?: boolean,
}
const { title, description, image, domain, ownFooter=false }: Props = Astro.props;
---

<BaseLayout {title} {description} {image} {domain}>
  <MainNav links={[
      { text: "Startseite", href: "#home" },
      { text: "Über uns", href: "#about" },
      { text: "Leistungen", href: "#services" },
      { text: "Reviews", href: "#reviews" },
      { text: "Kontakt", href: "#contact" }
  ]} />
  <div class="flex-grow">
    <slot />
  </div>
  { !ownFooter &&
    <Footer />
  }
  { ownFooter && <slot name="footer" />}
</BaseLayout>
