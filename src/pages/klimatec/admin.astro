---
import { Image } from "astro:assets";

// Layout
import BaseLayout from "../../layouts/BaseLayout.astro";

// Components
import Navigation from "../../components/klima-tec/molecules/Navigation.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/Section.astro";

import HeroSection from "../../components/klima-tec/sections/HeroSection.astro";

import Headline from "../../components/klima-tec/atoms/Headline.astro";
import SectionHeadline from "../../components/klima-tec/atoms/SectionHeadline.astro";
import Button from "../../components/klima-tec/atoms/Button.astro";

import ServiceCard from "../../components/klima-tec/molecules/ServiceCard.astro";
import Services from "../../components/klima-tec/molecules/Services.astro";
import IconInfoPanel from "../../components/klima-tec/molecules/IconInfoPanel.astro";
import BenefitItem from "../../components/klima-tec/molecules/BenefitItem.astro";
import WorkflowItem from "../../components/klima-tec/molecules/WorkflowItem.astro";

// Images
import Cards1 from "../../assets/images/server.png";
import Cards2 from "../../assets/images/cards-2.png";
import Cards3 from "../../assets/images/cards-3.png";
import Cards4 from "../../assets/images/cards-4.png";
import IconCircle from "../../components/klima-tec/atoms/IconCircle.astro";

const iconThickness = "1.5";


import HeroImage from "../../assets/images/hero-section-image.png";

import logo from '../../assets/svgs/ncc-klimatec-headline.svg?raw';
import ContactForm from "../../components/klima-tec/molecules/ContactForm.astro";
import ContactSection from "../../components/klima-tec/sections/ContactSection.astro";
import FooterLink from "../../components/klima-tec/molecules/FooterLink.astro";
import HeroItems from "../../components/klima-tec/molecules/HeroItems.astro";
import Underscore from "../../components/klima-tec/atoms/Underscore.astro";
import Login from "../../components/klima-tec/molecules/Login.astro";
import Label from "../../components/klima-tec/admin/Label.astro";
import Table from "../../components/klima-tec/admin/Table.astro";
import TableEntry from "../../components/klima-tec/admin/TableEntry.astro";
import TableFilter from "../../components/klima-tec/admin/TableFilter.astro";

export const prerender = false;

const { user, supabase } = Astro.locals;

let requests: {
  id: string;
  name: string;
  first_name: string | null;
  gender: string | null;
  birth_date: string | null;
  tel: string | null;
  street: string | null;
  zip_code: string | null;
  city: string | null;
  email: string;
  text_field: string | null;
  created_at: string;
  status: "Offen" | "InKontakt" | "AuftragAngenommen" | "Abgeschlossen" | "Gelöscht";
  favorite: boolean | null;
}[] = [];

const dateSortDirection = Astro.url.searchParams.get("sort") === "asc" ? "asc" : "desc";
const dateSortHref = `${Astro.url.pathname}?sort=${dateSortDirection === "asc" ? "desc" : "asc"}`;

const searchFilter = Astro.url.searchParams.get("search");
const fromDateFilter = Astro.url.searchParams.get("from");
const toDateFilter = Astro.url.searchParams.get("to");
const stateFilter = Astro.url.searchParams.getAll("state");
const favoriteFilter = Astro.url.searchParams.get("favorite");

let query = supabase
    .from("contact_requests")
    .select("id, first_name, name, gender, birth_date, tel, street, zip_code, city, email, text_field, created_at, status, favorite")

if (favoriteFilter) {
  query.filter("favorite", "eq", true);
}

if (stateFilter.length > 0) {
  query.filter("status", "in", `(${stateFilter.map((state) => `"${state}"`).join(",")})`);
} else {
  query.filter("status", "not.in", '("Abgeschlossen","Gelöscht")');
}

if (searchFilter) {
  query
    .or(`email.ilike.%${searchFilter}%,name.ilike.%${searchFilter}%,first_name.ilike.%${searchFilter}%,gender.ilike.%${searchFilter}%,text_field.ilike.%${searchFilter}%,tel.ilike.%${searchFilter}%,street.ilike.%${searchFilter}%,zip_code.ilike.%${searchFilter}%,city.ilike.%${searchFilter}%`)
}

if (fromDateFilter) {
  query.filter("created_at", "gt", fromDateFilter);
}

if (toDateFilter) {
  query.filter("created_at", "lte", toDateFilter);
}

query.order("created_at", { ascending: dateSortDirection === "asc" });

if (user) {
  const { data, error } = await query

  if (error) {
    console.error("Supabase select error:", error);
  }

  requests = data ?? [];
}
---

<BaseLayout
  title="NCC GmbH - Wir helfen bei IT-Problemen jeglicher Art"
  description="Die NCC GmbH ist Ihr Partner für IT-Service, Netzwerktechnik und smarte Sicherheitslösungen – kompetent, unabhängig und zuverlässig. Jetzt mehr über unser Leistungsspektrum erfahren."
  image="og-image.png"
  domain="https://nccgmbh.com/"
  design="klima-tec"
>

  <Navigation slot="nav" links={[]} />

  {
    !user && (
      <HeroSection id="klimatec-home" image={HeroImage}>
        <Headline bold level={2}>Admin Login</Headline>
        <div class="pr-16">
          <Login />
        </div>
      </HeroSection>
    )
  }


  {user && (
    <Section class="bg-[#f2f7fc] min-h-screen" paddingTop="medium">
      <div class="space-y-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <Headline level={1}>Kontaktanfragen</Headline>
          <form data-logout-form class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-[#e7f1fd] px-4 py-2.5 sm:justify-end">
            <p class="text-sm text-gray-600 flex flex-wrap gap-1">
              Angemeldet als <span class="font-semibold text-blue-900 break-words break-all max-w-full">{user.email}</span>
            </p>
            <Button as="button" type="submit">
              Logout
              <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            </Button>
          </form>
        </div>

        <TableFilter selectedStates={stateFilter} />

        <Table {dateSortHref} {dateSortDirection}>
          {requests.map((request) => (
            <TableEntry
              id={request.id}
              firstName={request.first_name ?? undefined}
              name={request.name}
              birthDate={request.birth_date ?? undefined}
              gender={request.gender ?? undefined}
              tel={request.tel ?? undefined}
              street={request.street ?? undefined}
              zipCode={request.zip_code ?? undefined}
              city={request.city ?? undefined}
              mail={request.email}
              request={request.text_field ?? ""}
              date={new Date(request.created_at)}
              status={request.status}
              favorite={request.favorite ?? false}
            />
          ))}
        </Table>

        <dialog data-request-dialog class="w-full max-md:!m-0 max-md:!min-h-screen max-w-2xl overflow-hidden md:rounded-lg p-0 shadow-[0_0_15px] shadow-black/25 backdrop:bg-black/50">
          <div class="flex max-md:h-screen md:max-h-[85vh] flex-col">
            <div class="flex shrink-0 items-start justify-between gap-4 px-6 pt-5 pb-2">
              <div class="flex items-center gap-3 min-w-0">
                <button data-dialog-favorite type="button" title="Als Favorit markieren" class="shrink-0 rounded-full p-2 hover:bg-yellow-50 transition-colors cursor-pointer">
                  <svg data-dialog-favorite-icon class="text-yellow-400" width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                </button>
                <div class="min-w-0">
                  <Headline bold level={3}><span data-dialog-name class="truncate"></span></Headline>
                  <p class="text-xs text-gray-500" data-dialog-date></p>
                </div>
              </div>
              <button data-dialog-close type="button" class="shrink-0 rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors cursor-pointer">
                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </div>

              <div class="flex flex-wrap gap-2 px-6 pb-5 border-b border-gray-200">
                <a data-dialog-mail class="inline-flex items-center gap-2 rounded-md bg-ncc-light-blue px-3 py-1.5 text-sm font-medium text-blue-900 hover:bg-blue-100 transition-colors cursor-pointer">
                  <svg width="15" height="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                  <span data-dialog-mail-text></span>
                </a>
                <a data-dialog-tel class="inline-flex items-center gap-2 rounded-md bg-ncc-light-blue px-3 py-1.5 text-sm font-medium text-blue-900 hover:bg-blue-100 transition-colors cursor-pointer">
                  <svg width="15" height="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                  <span data-dialog-tel-text></span>
                </a>
                <span class="inline-flex items-center gap-2 rounded-md bg-gray-100 px-3 py-1.5 text-sm text-gray-700">
                  <svg width="15" height="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                  <span data-dialog-address></span>
                </span>
              </div>

            <div class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-6 py-5">

              <div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-gray-400">Anliegen</p>
                <div class="w-full rounded-lg bg-ncc-light-blue p-4">
                  <p class="whitespace-pre-wrap text-sm" data-dialog-request></p>
                </div>
              </div>
            </div>

            <div class="flex shrink-0 flex-wrap items-center justify-between gap-3 rounded-b-lg border-t border-gray-200 bg-gray-50 px-6 py-4 max-md:pb-32">
              <div class="flex flex-wrap items-center gap-2">
                <label class="text-sm font-medium text-gray-600" for="dialog-status">Status</label>
                <select id="dialog-status" data-dialog-status class="rounded-md border border-gray-300 px-2 py-1.5 text-sm outline-blue-900">
                  <option value="Offen">Neu</option>
                  <option value="InKontakt">In Kontakt</option>
                  <option value="AuftragAngenommen">Auftrag angenommen</option>
                  <option value="Abgeschlossen">Abgeschlossen</option>
                </select>
                <p data-dialog-status-feedback class="hidden text-xs"></p>
              </div>
              <button
                type="button"
                data-dialog-delete
                class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors cursor-pointer"
              >
                <svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                Löschen
              </button>
            </div>
          </div>
        </dialog>
      </div>
    </Section>
  )}

  <script>
    document.querySelector("[data-logout-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      await fetch("/klimatec/api/logout", { method: "POST" });
      window.location.reload();
    });

    const dialog = document.querySelector<HTMLDialogElement>("[data-request-dialog]");
    const dialogMail = dialog?.querySelector<HTMLElement>("[data-dialog-mail]");
    const dialogMailText = dialog?.querySelector<HTMLElement>("[data-dialog-mail-text]");
    const dialogDate = dialog?.querySelector<HTMLElement>("[data-dialog-date]");
    const dialogRequest = dialog?.querySelector<HTMLElement>("[data-dialog-request]");

    const dialogName = dialog?.querySelector<HTMLElement>("[data-dialog-name]");
    const dialogTel = dialog?.querySelector<HTMLElement>("[data-dialog-tel]");
    const dialogTelText = dialog?.querySelector<HTMLElement>("[data-dialog-tel-text]");
    const dialogAddress = dialog?.querySelector<HTMLElement>("[data-dialog-address]");
    const formatAddress = (row: HTMLTableRowElement) => {
      const parts = [row.dataset.street, [row.dataset.zipCode, row.dataset.city].filter(Boolean).join(" ")].filter(Boolean);
      return parts.join(", ");
    };
    const dialogStatus = dialog?.querySelector<HTMLSelectElement>("[data-dialog-status]");
    const dialogDelete = dialog?.querySelector<HTMLButtonElement>("[data-dialog-delete]");
    const dialogFavorite = dialog?.querySelector<HTMLButtonElement>("[data-dialog-favorite]");
    const dialogFavoriteIcon = dialog?.querySelector<SVGElement>("[data-dialog-favorite-icon]");
    const dialogStatusFeedback = dialog?.querySelector<HTMLElement>("[data-dialog-status-feedback]");

    let currentRequestId: string | undefined;
    let currentRequestRow: HTMLTableRowElement | undefined;

    const STATUS_LABELS: Record<string, { text: string; colorClass: string }> = {
      Offen: { text: "Neu", colorClass: "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20" },
      InKontakt: { text: "In Kontakt", colorClass: "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20" },
      AuftragAngenommen: { text: "Auftrag angenommen", colorClass: "bg-indigo-50 text-indigo-700 ring-1 ring-inset ring-indigo-600/20" },
      Abgeschlossen: { text: "Abgeschlossen", colorClass: "bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20" },
      Gelöscht: { text: "Gelöscht", colorClass: "bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-500/20" },
    };

    const updateStatus = async (status: string, trigger: HTMLElement) => {
      if (!currentRequestId) return false;

      dialogStatusFeedback?.classList.add("hidden");
      trigger.setAttribute("disabled", "true");

      try {
        const response = await fetch("/klimatec/api/status", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: currentRequestId, status }),
        });

        if (!response.ok) {
          throw new Error("Status konnte nicht aktualisiert werden.");
        }

        if (currentRequestRow) {
          currentRequestRow.dataset.status = status;

          const label = currentRequestRow.querySelector<HTMLElement>("[data-status-label] > div");
          const info = STATUS_LABELS[status];
          if (label && info) {
            label.textContent = info.text;
            label.className = `py-1 px-3 text-xs font-semibold rounded-full w-fit text-nowrap ${info.colorClass}`;
          }
        }

        return true;
      } catch (error) {
        console.error(error);
        if (dialogStatusFeedback) {
          dialogStatusFeedback.textContent = "Status konnte nicht gespeichert werden.";
          dialogStatusFeedback.classList.remove("hidden");
          dialogStatusFeedback.classList.add("text-red-600");
        }
        return false;
      } finally {
        trigger.removeAttribute("disabled");
      }
    };

    dialogStatus?.addEventListener("change", () => {
      updateStatus(dialogStatus.value, dialogStatus);
    });

    dialogDelete?.addEventListener("click", async () => {
      if (!confirm("Diese Anfrage wirklich löschen?")) return;

      const success = await updateStatus("Gelöscht", dialogDelete);
      if (success) {
        currentRequestRow?.remove();
        dialog?.close();
      }
    });

    const filter = document.querySelector<HTMLFormElement>("[data-table-filter]");

    filter?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const url = new URL(window.location.href);

      const filterData = new FormData(filter);

      for (const key of new Set([...filterData.keys(), "state"])) {
        url.searchParams.delete(key);
      }

      for (const [key, value] of filterData) {
        if (value) {
          url.searchParams.append(key, value.toString());
        }
      }

      window.location.href = url.toString();
    });

    const resetFilter = filter?.querySelector<HTMLButtonElement>("[data-reset-filter]");
    
    resetFilter?.addEventListener("click", async (event) => {
      event.preventDefault();

      const url = new URL(window.location.href);

      url.searchParams.delete("search");
      url.searchParams.delete("state");
      url.searchParams.delete("from");
      url.searchParams.delete("to");

      window.location.href = url.toString();      
    })

    const updateFavorite = async (favorite: boolean) => {
      if (!currentRequestId) {
        return;
      }

      const response = await fetch("/klimatec/api/favorite", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: currentRequestId, favorite }),
      });

      if (!response.ok) {
        throw new Error("Favorit konnte nicht aktualisiert werden.");
      }
    }

    document.querySelectorAll<HTMLTableRowElement>("[data-request-row]").forEach((row) => {
      const openDialog = () => {
        if (dialogMail) {
          dialogMail.setAttribute("href", `mailto:${row.dataset.mail}`);
        }
        if (dialogMailText) dialogMailText.textContent = row.dataset.mail ?? "";

        document.body.classList.add("max-md:overflow-hidden");

        const SUBJECT = "KlimaTec Antwort";

        dialogMailText?.addEventListener("click", () => {
          const salutation =
            row.dataset.gender === "male" ? `Sehr geehrter Herr ${row.dataset.lastName}` :
            row.dataset.gender === "female" ? `Sehr geehrte Frau ${row.dataset.lastName}` :
            "Sehr geehrte Damen und Herren";

          const quotedRequest = (row.dataset.request ?? "")
            .split("\n")
            .map((line) => `> ${line}`)
            .join("\n");

          const finalMessage = [
            `${salutation},`,
            "",
            "vielen Dank für Ihre Anfrage:",
            "",
            quotedRequest,
            "",
            "",
            "",
            "Mit freundlichen Grüßen",
            "Ihr KlimaTec Team",
          ].join("\n");

          // Öffnet NUR das Standard-Mailprogramm mit fertig befüllter Mail
          const href = `mailto:${row.dataset.mail}?subject=${encodeURIComponent(SUBJECT)}&body=${encodeURIComponent(finalMessage)}`;
          window.location.href = href;
        });

        dialogFavorite?.addEventListener("click", async () => {
          const nextFavorite = row.dataset.favorite !== "true";

          try {
            await updateFavorite(nextFavorite);
            row.dataset.favorite = String(nextFavorite);
            dialogFavoriteIcon?.classList.toggle("fill-yellow-400", nextFavorite);
          } catch (error) {
            console.error(error);
          }
        })

        if (dialogDate) dialogDate.textContent = row.dataset.date ?? "";
        if (dialogRequest) dialogRequest.textContent = row.dataset.request ?? "";
        if (dialogName) dialogName.textContent = `${row.dataset.firstName ?? ""} ${row.dataset.lastName ?? ""}`.trim();
        if (dialogTel) {
          dialogTel.classList.toggle("hidden", !row.dataset.tel);
          dialogTel.setAttribute("href", `tel:${row.dataset.tel}`);
        }
        if (dialogTelText) dialogTelText.textContent = row.dataset.tel ?? "";
        if (dialogAddress) dialogAddress.textContent = formatAddress(row);
        if (dialogStatus) dialogStatus.value = row.dataset.status ?? "Offen";
        if (dialogStatusFeedback) dialogStatusFeedback.classList.add("hidden");
        if (dialogFavoriteIcon) {
          dialogFavoriteIcon.classList.toggle("fill-yellow-400", row.dataset.favorite === "true");
        }
        currentRequestId = row.dataset.id;
        currentRequestRow = row;
        dialog?.showModal();
      };

      row?.addEventListener("click", openDialog);
      row?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openDialog();
        }
      });
    });

    const closeDialog = () => {
      dialog?.close();
    }

    dialog?.addEventListener("close", () => {
      document.body.classList.remove("max-md:overflow-hidden");
    });

    dialog?.querySelector("[data-dialog-close]")?.addEventListener("click", closeDialog);

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });
  </script>
</BaseLayout>
