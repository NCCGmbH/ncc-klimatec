---
// Layout
import BaseLayout from "../layouts/BaseLayout.astro";

// Components
import Navigation from "../components/Navigation.astro";
import HeroSection from "../components/HeroSection.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import ServicesItem from "../components/ServicesItem.astro";
import ReviewSection from "../components/ReviewSection.astro";
import Review from "../components/Review.astro";
import ContactForm from "../components/ContactForm.astro";
import Form from "../components/Form.astro";
import InputField from "../components/InputField.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

// Images
import HeroImage from "../assets/images/tastatur.jpg";
import Logo from "../assets/images/logo.png";
import picart_pc from "../assets/images/picart_pc.png";
import Helpmed from "../assets/images/helpmed.jpg";
import Laptop from "../assets/images/laptop.jpg";
import Beratung from "../assets/images/Beratung.jpg";
import Netzwerk from "../assets/images/Netzwerk.jpg";
import Settings from "../assets/images/Settings.jpg";
import nccRealEstate from "../assets/images/ncc_real_estate.png";
import myBodyMinerals from "../assets/images/logo_my_body_minerals.jpg";
import logoEos from "../assets/images/logo_eos.png";
---

<BaseLayout
  title="NCC GmbH - Wir helfen bei IT-Problemen jeglicher Art"
  description="Die NCC GmbH ist Ihr Partner für IT-Service, Netzwerktechnik und smarte Sicherheitslösungen – kompetent, unabhängig und zuverlässig. Jetzt mehr über unser Leistungsspektrum erfahren."
  image="og-image.png"
  domain="https://nccgmbh.com/"
>

  <Navigation slot="nav" links={[
    { text: "Startseite", href: "#home" },
    { text: "Leistungen", href: "#services" },
    { text: "Über uns", href: "#about" },
    { text: "Subdevisions", href: "#subdevisions" },
    { text: "Kontakt", href: "#contact" }
  ]} />
  
  <HeroSection 
    title="Wir helfen bei IT-Problemen jeglicher Art"
    heroImage={HeroImage}
    button={{
      text: "Kontakt aufnehmen",
      href: "#contact"
    }}
  >
    <div slot="subtitle" class="space-y-2">
      <p>Professionelle IT-Dienstleistungen, Netzwerktechnik und maßgeschneiderte Sicherheitslösungen für Privatpersonen und Unternehmen.</p>
      <ul class="list-disc list-inside">
        <li>Persönlich. Schnell. Unabhängig.</li>
      </ul>
    </div>
  </HeroSection>


  <Services
    bgColor="white"
    headline="Leistungen"
    ID="services"
  >
    <ServicesItem 
      headline="IT-Service & Reparatur" 
      image={Laptop}
      alt="Spinat"
      id={1}
    >
      Ob defekter Laptop, langsamer PC oder fehlerhafte Software – wir finden die Ursache und lösen das Problem effizient. Vor-Ort-Service oder Fernwartung – Sie entscheiden!
    </ServicesItem>
    <ServicesItem 
      headline="Netzwerk & Infrastruktur" 
      image={Netzwerk}
      alt="Kräuter"
      id={2}
    >
      Vom privaten WLAN bis zum komplexen Firmennetzwerk: Wir planen, installieren und betreuen Ihre Netzwerklösungen – sicher, zuverlässig und herstellerunabhängig.
    </ServicesItem>
    <ServicesItem 
      headline="Beratung & Betreuung" 
      image={Beratung}
      alt="Steine"
      id={3}
    >
      Wir unterstützen Sie bei der Auswahl und Einrichtung moderner Technik – mit individueller Beratung, verständlich erklärt. Ideal für Privatpersonen und kleine Unternehmen.
    </ServicesItem>
    <ServicesItem 
      headline="Sicherheit & Smart Home" 
      image={Settings}
      alt="Steine"
      id={4}
    >
      Ob Kameraüberwachung, Alarmanlage oder intelligente Lichtsteuerung – wir setzen Ihre Wünsche in Sachen Sicherheit und Komfort technisch sauber um.
    </ServicesItem>
  </Services>

  <About
    bgColor="gray"
    headline="Über uns"
    subtitle="NCC GmbH – Ihr verlässlicher Partner für zukunftsfähige IT- und Kommunikationslösungen."
    image={Logo}
  >
    Die <strong>NCC Network Communication Computer GmbH </strong>mit Sitz in Undenheim steht seit über 30 Jahren für zuverlässige IT‑Lösungen und moderne Kommunikationstechnologien. 
    <br />
    <strong>Ob Netzwerktechnik, IT-Sicherheit, VoIP oder Cloud:</strong> 
    <br />
    Wir entwickeln maßgeschneiderte Systeme, die auf die individuellen Bedürfnisse unserer Kunden abgestimmt sind.
    <br />
    <br />
    Unser erfahrenes Team verbindet technisches Know-how mit praxisnaher Beratung – effizient, kreativ und lösungsorientiert. Dabei setzen wir auf persönliche Betreuung und langfristige Partnerschaften, um Unternehmen technologisch nachhaltig zu unterstützen.
  </About>

 <Services
    bgColor="white"
    headline="Subdevisions"
    ID="subdevisions"
  >

  <ServicesItem 
      headline="HelpMED" 
      image={Helpmed}
      alt="HelpMED"
      fullWidth
      id={5}
    >
      Helpmed berät Patienten ganzheitlich im Bereich der Orthomolekularmedizin, Mikronährstofftherapie und Ernährungsoptimierung. Unsere Mission ist es, Gesundheit ursachenorientiert zu fördern und körperliche Balance zu erhalten.
    </ServicesItem>

     <ServicesItem 
      headline="myBodyMinerals" 
      image={myBodyMinerals}
      alt="myBodyMinerals"
      fullWidth
      id={6}
    >
      myBodyMinerals begleitet Sie auf dem Weg zu mehr Energie und Wohlbefinden mit individuell abgestimmten Nahrungsergänzungen. Nach einer Blutanalyse erhalten Sie genau die Mineralstoffe und Vitamine, die Ihr Körper wirklich braucht.
    </ServicesItem>

    <ServicesItem 
      headline="EOS Designs" 
      image={logoEos}
      alt="EOS Design"
      fullWidth
      id={7}
    >
      EOS Design steht für luxuriöse Maßanfertigung, die höchste Schneiderkunst mit exklusiven Stoffen verbindet. Jedes Kleidungsstück ist ein Unikat, das Eleganz und Persönlichkeit auf unvergleichliche Weise vereint.
    </ServicesItem>
    
    <ServicesItem 
      headline="NCC Real Estate" 
      image={nccRealEstate}
      alt="NCC Real Estate"
      fullWidth
      padding
      id={8}
    >
      NCC Real Estate begleitet Sie kompetent beim Kauf und Verkauf von Immobilien. Als lizenzierte Makler bieten wir professionelle Beratung und eine zuverlässige Abwicklung rund um Ihre Immobilie.
    </ServicesItem>
  </Services>

  <ContactForm 
    bgColor="gray"
    contactLines={[
      "Telefon: 06737 761073",
      "Mobile: 0151 59044488",
      "Fax: 06737 751074",
      "E-Mail: info@nccgmbh.de"
    ]}
  >
    <p>Bei persönlichen Fragen schreiben Sie uns gerne eine E-Mail über das Kontaktformular.</p>
    <Form>
      <InputField itype="text" id="name" name="name" required>
        Name:
      </InputField>
      <InputField itype="text" id="telefon" name="email" required>
        Telefon:
      </InputField>
      <InputField itype="textarea" id="message" name="message" required>
        Nachricht:
      </InputField>
      <Button id="openMail" as="a" href="">Absenden</Button>
    </Form>
  </ContactForm>

  <script>
    const TO = "info@nccgmbh.de";                 // << anpassen
    const SUBJECT = "Anfrage NCC Webseite";    // << optional

    const openMail = document.getElementById("openMail")

    openMail?.addEventListener("click", () => {
      const message = document.getElementById("message") as HTMLInputElement;
      const name = document.getElementById("name") as HTMLInputElement;
      const telefon = document.getElementById("telefon") as HTMLInputElement;
      const nameStr = name?.value.trim();
      const telefonStr = telefon?.value.trim();
      const msg = message?.value.trim();
      if (!msg || !nameStr ||  !telefonStr) { alert("Bitte alle Felder ausfüllen."); return; }

      const finalMessage = `Name: ${nameStr}\n\nTelefon: ${telefonStr}\n\n${msg}`;

      // Öffnet NUR das Standard-Mailprogramm mit fertig befüllter Mail
      const href = `mailto:${TO}?subject=${encodeURIComponent(SUBJECT)}&body=${encodeURIComponent(finalMessage)}`;
      window.location.href = href;
    });
  </script>

  <Footer slot="footer" 
    text="© 2025 NCC Network Communication Computer GmbH"
    links={[
      { text: "Impressum", href: "/impressum" },
      { text: "Datenschutz", href: "/datenschutz" },
      { text: "Kontakt", href: "#contact" }
    ]}
  />

</BaseLayout>
