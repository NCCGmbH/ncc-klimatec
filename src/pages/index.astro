---
// Layout
import BaseLayout from "../layouts/BaseLayout.astro";

// Components
import Navigation from "../components/Navigation.astro";
import HeroSection from "../components/HeroSection.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import ServicesItem from "../components/ServicesItem.astro";
import ReviewSection from "../components/ReviewSection.astro";
import Review from "../components/Review.astro";
import ContactForm from "../components/ContactForm.astro";
import Form from "../components/Form.astro";
import InputField from "../components/InputField.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

// Images
import HeroImage from "../assets/images/tastatur.jpg";
import Profil from "../assets/images/profil.jpg";
import Spinat from "../assets/images/spinat.png";
import Krauter from "../assets/images/krauter.png";
import Steine from "../assets/images/steine.png";
import Blatt from "../assets/images/blatt.png";
---

<BaseLayout
  title="NCC GmbH - Wir helfen bei IT-Problemen jeglicher Art"
  description="Die NCC GmbH ist Ihr Partner für IT-Service, Netzwerktechnik und smarte Sicherheitslösungen – kompetent, unabhängig und zuverlässig. Jetzt mehr über unser Leistungsspektrum erfahren."
  image="og-image.png"
  domain="https://nccgmbh.com/"
>

  <Navigation slot="nav" links={[
    { text: "Startseite", href: "#home" },
    { text: "Leistungen", href: "#services" },
    { text: "Reviews", href: "#reviews" },
    { text: "Über uns", href: "#about" },
    { text: "Subdevisionss", href: "#subdevisions" },
    { text: "Kontakt", href: "#contact" }
  ]} />
  
  <HeroSection 
    title="Wir helfen bei IT-Problemen jeglicher Art"
    heroImage={HeroImage}
    button={{
      text: "Jetzt Termin vereinbaren",
      href: "https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form"
    }}
  >
    <p slot="subtitle">Mit moderner Orthomolekularmedizin, Mikronährstofftherapie und individuelle Beratung<br />&ndash; fundiert, individuell, effektiv</p>
  </HeroSection>


  <Services
    bgColor="gray"
    headline="Leistungen"
    ID="services"
  >
    <ServicesItem 
      headline="Integrale Ernährung" 
      image={Spinat}
      alt="Spinat"
      id={1}
    >
      Analytische Ernährungsberatung zur Verbesserung von Energie, Stoffwechsel und Lebensqualität - abgestimmt auf Ihre körperliche Konstitution.
    </ServicesItem>
    <ServicesItem 
      headline="Mikronährstofftherapie" 
      image={Krauter}
      alt="Kräuter"
      id={2}
    >
      Gezielte Zufuhr von Vitaminen, Spurenelementen, Aminosäuren und sekundären Pflanzenstoffen zur Unterstützung von Zellfunktion, Immunabwehr und Leistungsfähigkeit.
    </ServicesItem>
    <ServicesItem 
      headline="Ordnungstherapie" 
      image={Steine}
      alt="Steine"
      id={3}
    >
      Strukturschaffung für Körper und Geist - mit gesunder Tagesrhythmik, Stressmanagement und praxisnahen Alltagsstrategien.
    </ServicesItem>
    <ServicesItem 
      headline="Darmgesundheit" 
      image={Blatt}
      alt="Blatt"
      id={4}
    >
      Analyse und Regulation der Darmflora (Mikrobiom) zur Behandlung von Verdauungsbeschwerden, Immunschwächen und chronischen Entzündungen.
    </ServicesItem>
  </Services>

  <ReviewSection
    headline="Patientenbewertungen"
    bgColor="white"
  >
    <Review 
      text="Frau Staubitz hat mir geholfen, meine chronische Erschöpfung endlich in den Griff zu bekommen."
      info="Julia R., 38"
    />
    <Review 
      text="Ich fühlte mich zum ersten Mal wirklich ganzheitlich betrachtet. Keine bloße Symptombehandlung - sondern Ursachenklärung."
      info="Tobias W., 44"
    />
    <Review 
      text="Nach der Darmtherapie waren meine Beschwerden wie weggeblasen. Danke für die klare Diagnostik und einfühlsame Betreuung."
      info="Jan O., 30"
    />
  </ReviewSection>

  <About
    bgColor="white"
    headline="Über uns"
    subtitle="helpMED - Ihre Praxis für ganzheitliche, wissenschaftlich fundierte Gesundheit."
    image={Profil}
  >
    Unter der Leitung von Elena Staubitz (Ärztin, LT) verbinden wir moderne orthomolekulare Medizin 
    mit persönlicher Betreuung. Unsere Philosophie: Gesundheit ist kein Zufall - sondern das Ergebnis 
    gezielter Unterstützung Ihrer körpereigenen Systeme.
    <br />
    <br />
    Die Praxis befindet sich im Gesundheitshaus Undenheim gemeinsam mit Herrn Dr. Albrecht 
    (Facharzt für Allgemeinmedizin).
  </About>

 <Services
    bgColor="gray"
    headline="Subdevisions"
    ID="subdevisions"
  >
    <ServicesItem 
      headline="Integrale Ernährung" 
      image={Spinat}
      alt="Spinat"
      id={1}
    >
      Analytische Ernährungsberatung zur Verbesserung von Energie, Stoffwechsel und Lebensqualität - abgestimmt auf Ihre körperliche Konstitution.
    </ServicesItem>
    <ServicesItem 
      headline="Mikronährstofftherapie" 
      image={Krauter}
      alt="Kräuter"
      id={2}
    >
      Gezielte Zufuhr von Vitaminen, Spurenelementen, Aminosäuren und sekundären Pflanzenstoffen zur Unterstützung von Zellfunktion, Immunabwehr und Leistungsfähigkeit.
    </ServicesItem>
    <ServicesItem 
      headline="Ordnungstherapie" 
      image={Steine}
      alt="Steine"
      id={3}
    >
      Strukturschaffung für Körper und Geist - mit gesunder Tagesrhythmik, Stressmanagement und praxisnahen Alltagsstrategien.
    </ServicesItem>
    <ServicesItem 
      headline="Darmgesundheit" 
      image={Blatt}
      alt="Blatt"
      id={4}
    >
      Analyse und Regulation der Darmflora (Mikrobiom) zur Behandlung von Verdauungsbeschwerden, Immunschwächen und chronischen Entzündungen.
    </ServicesItem>
  </Services>

  <ContactForm 
    contactLines={[
      "Telefon: 0171 6547853",
      "E-Mail: info@helpmed.de"
    ]}
    button={{
      text: "Jetzt Termin vereinbaren",
      href: "https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form"
    }}
  >
    <p>Bei persönlichen Fragen schreiben Sie uns gerne eine E-Mail über das Kontaktformular.</p>
    <Form>
      <InputField itype="text" id="name" name="name" required>
        Name:
      </InputField>
      <InputField itype="email" id="email" name="email" required>
        E-Mail:
      </InputField>
      <InputField itype="textarea" id="message" name="message" required>
        Nachricht:
      </InputField>
      <Button as="a" href="https://ncc.encece.de/index.php/apps/appointments/pub/QoeEROlgMdkSdssEYg%3D%3D/form">Absenden</Button>
    </Form>
  </ContactForm>

  <Footer slot="footer" 
    text="© 2025 helpMED - A subdivision of NCC GmbH"
    links={[
      { text: "Impressum", href: "/impressum" },
      { text: "Datenschutz", href: "/datenschutz" },
      { text: "Kontakt", href: "#contact" }
    ]}
  />

</BaseLayout>
