---
import Layout from "../layouts/layout.astro";
import TextBlock from "../components/textBlock.astro";
import Header from "../components/header.astro";

import Services from "../components/Services.astro";
import ServicesItem from "../components/ServicesItem.astro";
import About from "../components/About.astro";
import ContactForm from "../components/ContactForm.astro";

import Spinat from "../assets/images/spinat.png";
import Krauter from "../assets/images/krauter.png";
import Steine from "../assets/images/steine.png";
import Blatt from "../assets/images/blatt.png";
import Profil from "../assets/images/profil.jpg";
import Patientenbewertungen from "../components/Patientenbewertungen.astro";
---

<Layout
  title="helpMED - Ihre Praxis für ganzheitliche, wissenschaftlich fundierte Gesundheit"
  description="helpMED bietet moderne orthomolekulare Medizin, Mikronährstofftherapie und integrative Beratung für Ihre Gesundheit. Erfahren Sie mehr über unsere Leistungen und Philosophie."
  image="og-image.png"
  domain="https://helpmed.de"
>
  <Header />
  
  <About
    bgColor="white"
    h2="Über uns"
    h3="helpMED - Ihre Praxis für ganzheitliche, wissenschaftlich fundierte Gesundheit."
    image={Profil}
  >
    Unter Leitung von Elena Staubitz (Ärztin, LT) verbinden wir moderne orthomolekulare Medizin 
    mit persönlicher Betreuung. Unsere Philosophie: Gesundheit ist kein Zufall - sondern das Ergebnis 
    gezielter Unterstützung Ihrer körpereigenen Systeme.
    <br />
    <br />
    Die Praxis befindet sich im Gesundheitshaus Undenheim gemeinsam mit Herrn Dr. Albrecht 
    (Facharzt für Allgemeinmedizin).
  </About>

  <Services head>
    <ServicesItem 
      headline="Integrale Ernährung" 
      image={Spinat}
      alt="Spinat"
      id={1}
    >
      Analytische Ernährungsberatung zur Verbesserung von Energie, Stoffwechsel und Lebensqualität - abgestimmt auf Ihre körperliche Konstitution.
    </ServicesItem>
    <ServicesItem 
      headline="Mikronährstofftherapie" 
      image={Krauter}
      alt="Kräuter"
      id={2}
    >
      Gezielte Zufuhr von Vitaminen, Spurenelementen, Aminosäuren und sekundären Pflanzenstoffen zur Unterstützung von Zellfunktion, Immunabwehr und Leistungsfähigkeit.
    </ServicesItem>
    <ServicesItem 
      headline="Ordnungstherapie" 
      image={Steine}
      alt="Steine"
      id={3}
    >
      Strukturschaffung für Körper und Geist - mit gesunder Tagesrhythmik, Stressmanagement und praxisnahen Alltagsstrategien.
    </ServicesItem>
    <ServicesItem 
      headline="Darmgesundheit" 
      image={Blatt}
      alt="Blatt"
      id={4}
    >
      Analyse und Regulation der Darmflora (Mikrobiom) zur Behandlung von Verdauungsbeschwerden, Immunschwächen und chronischen Entzündungen.
    </ServicesItem>
  </Services>

  <Patientenbewertungen />

  <ContactForm />
</Layout>
